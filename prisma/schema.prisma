generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ClanekKategorie {
  SPOJENCI
  NEPRATELE
  NABOZENSTVI
}

model Clanek {
  id        String   @id @default(cuid())
  nazev     String
  obsah     String
  image     String?
  kategorie ClanekKategorie

  order     Decimal @db.Decimal(10, 5)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
}

model Tazeni {
  id        String   @id @default(cuid())
  jmeno     String
  vypravec  String
  postavy   String
  pribeh    String
  obdobi    String?
  image     String?

  order     Int      @default(0)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([order])
}

model Postava {
  id         String   @id @default(cuid())
  jmeno       String
  rasa       String
  povolani String
  hrac     String
  tazeni   String?
  popis    String?
  image      String?

  order      Int      @default(0)
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  author     User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([order])
}

model Lokalita {
  id          String       @id @default(cuid())
  nazev       String
  popis       String?
  image       String?

  parentId  String?
  parent    Lokalita?   @relation("Hierarchy", fields: [parentId], references: [id])
  children  Lokalita[]  @relation("Hierarchy")

  uroven   LokalitaUroven
  
  order      Int      @default(0)
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id])
}

model Mapa {
  id          String       @id @default(cuid())
  nazev       String
  popis       String?
  image       String?

  parentId  String?
  parent    Mapa?   @relation("Hierarchy", fields: [parentId], references: [id])
  children  Mapa[]  @relation("Hierarchy")

  uroven   LokalitaUroven

  order      Int      @default(0)
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id])
}

enum LokalitaUroven {
  SVET
  KRALOVSTVI
  KRAJ
  MISTO
}

model Letopisy {
  id          String       @id @default(cuid())
  nadpis      String
  popis       String?

  datePrecision String

  year  Int
  month Int?
  day   Int?

  season String?

  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id])
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(READER)
  accounts      Account[]
  postavy       Postava[]
  sessions      Session[]
  tazeni        Tazeni[]
  clanek        Clanek[]
  kraje         Lokalita[]
  mapy          Mapa[]
  letopisy      Letopisy[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  access_token      String?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  expires_at        Int?
  refresh_token     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  READER
  EDITOR
  ADMIN
}
