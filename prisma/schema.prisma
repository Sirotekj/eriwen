generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(READER)
  accounts      Account[]
  postavy       Postava[]
  sessions      Session[]
  tazeni        Tazeni[]
}

model Tazeni {
  id        String   @id @default(cuid())
  jmeno      String
  vypravec    String
  postavy   String
  pribeh   String
  obdobi    String?
  image     String?
  authorId  String
  createdAt DateTime @default(now())
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([order])
}

model Postava {
  id         String   @id @default(cuid())
  jmeno       String
  rasa       String
  povolani String
  hrac     String
  tazeni   String?
  popis    String?
  image      String?
  authorId   String
  createdAt  DateTime @default(now())
  order      Int      @default(0)
  updatedAt  DateTime @updatedAt
  author     User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([order])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  access_token      String?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  expires_at        Int?
  refresh_token     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  READER
  EDITOR
  ADMIN
}
